# GNC inc — port 3000
[Unit]
Description=GNC inc (port 3000)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gnc/gnc-inc
EnvironmentFile=-/opt/gnc/gnc-inc/.env
Environment=NODE_ENV=production
ExecStart=node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=6
StandardOutput=append:/var/log/gnc/inc.log
StandardError=append:/var/log/gnc/inc.log

[Install]
WantedBy=multi-user.target
